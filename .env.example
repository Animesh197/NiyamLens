# NiyamLens environment template.
# Copy to `.env` in the repository root and replace the placeholders.
# `.env` is git-ignored. Never commit real passwords or API keys.

# --- Application ---------------------------------------------------------
# One of: development, test, production
NIYAMLENS_ENVIRONMENT=development
NIYAMLENS_LOG_LEVEL=INFO

# --- Local PostgreSQL + pgvector (Docker Compose, see docker-compose.yml) --
# Used by Docker Compose to initialise the isolated `niyamlens` database.
NIYAMLENS_DB_USER=niyamlens
NIYAMLENS_DB_PASSWORD=replace-with-a-local-password

# Application database URL (SQLAlchemy + Psycopg 3). NiyamLens uses port 5433,
# never 5432. The password must match NIYAMLENS_DB_PASSWORD above.
DATABASE_URL=postgresql+psycopg://niyamlens:replace-with-a-local-password@127.0.0.1:5433/niyamlens

# --- Opt-in database integration test -------------------------------------
# Leave unset to skip the integration test. When set, it must point to the
# isolated NiyamLens database on 127.0.0.1:5433 (database `niyamlens` or
# `niyamlens_*`); any other target makes the test fail instead of running.
# NIYAMLENS_TEST_DATABASE_URL=postgresql+psycopg://niyamlens:replace-with-a-local-password@127.0.0.1:5433/niyamlens

# --- AI model / embedding provider ----------------------------------------
# Deferred to a later milestone. No provider is configured or called yet.
